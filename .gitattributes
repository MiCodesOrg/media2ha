# Normalise line endings in the repository to LF; check out LF everywhere except
# Windows batch scripts, which require CRLF.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
