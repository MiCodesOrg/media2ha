<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin_horizontal"
        android:paddingTop="@dimen/screen_margin_vertical"
        android:paddingBottom="@dimen/screen_margin_vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/section_spacing">

            <ImageView
                android:id="@+id/header_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_app_header" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_title"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Permission card -->
        <LinearLayout
            android:id="@+id/permission_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                style="@style/Widget.Media2HA.Section"
                android:text="@string/permission_section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/permission_explanation"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/permission_button"
                style="@style/Widget.Media2HA.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/grant_permission" />
        </LinearLayout>

        <!-- Status hero -->
        <LinearLayout
            android:id="@+id/status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/status_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_status"
                    android:tint="@color/status_ok" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_waiting"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/status_context"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/test_button_hero"
                    style="@style/Widget.Media2HA.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:text="@string/action_test" />

                <Button
                    android:id="@+id/modify_button"
                    style="@style/Widget.Media2HA.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/action_modify" />
            </LinearLayout>

            <Button
                android:id="@+id/unpublish_button"
                style="@style/Widget.Media2HA.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/action_unpublish" />
        </LinearLayout>

        <!-- Configuration form -->
        <LinearLayout
            android:id="@+id/form_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                style="@style/Widget.Media2HA.Section"
                android:text="@string/section_connection" />

            <TextView
                style="@style/Widget.Media2HA.Label"
                android:layout_marginTop="14dp"
                android:text="@string/label_broker" />

            <EditText
                android:id="@+id/mqtt_host_edit"
                style="@style/Widget.Media2HA.Field"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_host"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionNext" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/mqtt_auth_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="@dimen/button_height"
                android:text="@string/auth_toggle"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/mqtt_auth_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.Media2HA.Label"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_username" />

                <EditText
                    android:id="@+id/mqtt_username_edit"
                    style="@style/Widget.Media2HA.Field"
                    android:layout_marginTop="6dp"
                    android:hint="@string/hint_username"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionNext"
                    android:autofillHints="username" />

                <TextView
                    style="@style/Widget.Media2HA.Label"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_password" />

                <EditText
                    android:id="@+id/mqtt_password_edit"
                    style="@style/Widget.Media2HA.Field"
                    android:layout_marginTop="6dp"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:autofillHints="password" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Media2HA.Section"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/section_device" />

            <TextView
                style="@style/Widget.Media2HA.Label"
                android:layout_marginTop="14dp"
                android:text="@string/label_device_name" />

            <EditText
                android:id="@+id/mqtt_device_name_edit"
                style="@style/Widget.Media2HA.Field"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_device_name"
                android:inputType="textCapWords"
                android:imeOptions="actionDone" />

            <Button
                android:id="@+id/advanced_toggle"
                style="@style/Widget.Media2HA.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/advanced_closed" />

            <LinearLayout
                android:id="@+id/advanced_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.Media2HA.Label"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_port" />

                <EditText
                    android:id="@+id/mqtt_port_edit"
                    style="@style/Widget.Media2HA.Field"
                    android:layout_marginTop="6dp"
                    android:hint="@string/hint_port"
                    android:inputType="number"
                    android:maxLength="5"
                    android:imeOptions="actionNext" />

                <TextView
                    style="@style/Widget.Media2HA.Label"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_device_id" />

                <EditText
                    android:id="@+id/mqtt_device_id_edit"
                    style="@style/Widget.Media2HA.Field"
                    android:layout_marginTop="6dp"
                    android:hint="@string/hint_device_id"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionNext" />

                <TextView
                    style="@style/Widget.Media2HA.Label"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_prefix" />

                <EditText
                    android:id="@+id/mqtt_prefix_edit"
                    style="@style/Widget.Media2HA.Field"
                    android:layout_marginTop="6dp"
                    android:hint="@string/hint_discovery_prefix"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionDone" />

                <TextView
                    android:id="@+id/adb_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:text="@string/adb_instructions"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/test_mqtt_button"
                    style="@style/Widget.Media2HA.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:text="@string/action_test" />

                <Button
                    android:id="@+id/cancel_button"
                    style="@style/Widget.Media2HA.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/action_cancel"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/test_result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/save_config_button"
                style="@style/Widget.Media2HA.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/action_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
